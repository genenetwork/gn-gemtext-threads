# PI.dev


```
mkdir workdir && cd workdir
mkdir -p $HOME/.local $HOME/.config/maki

guix shell -C -N -F gzip ncurses which findutils gawk tmux curl ripgrep fzf guix guile ruby python bash openssl nss-certs coreutils grep sed jq git xz gcc-toolchain rust rust:cargo tar --share=$HOME/.local --share=$HOME/tmp=/tmp --share=/var/guix/daemon-socket/ --expose=/gnu/store

curl -fsSL https://pi.dev/install.sh | sh

export PATH="/home/wrk/.local/share/pi-node/node-v22.23.2-linux-x64/bin:$PATH"
```

For specials

```
npx @lunaroute/cli setup pi
```

